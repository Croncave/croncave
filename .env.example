# Croncave: local environment
#
# Copy this file and edit your copy. `.env` is git-ignored and must never be
# committed; CI fails the build if one ever is.
#
#     cp .env.example .env
#
# Binaries load `.env` at startup. A real environment variable always wins
# over a value in this file, so staging and production — where no `.env`
# exists — are unaffected. The web app reads this same file.
#
# Secrets are blank here on purpose. Put values only in your own `.env`.
#
# Every variable the code reads belongs in this file, so there is one place to
# look when something isn't set. Later build steps add their own sections.

# ---------------------------------------------------------------------------
# Telemetry (crates/telemetry)
# ---------------------------------------------------------------------------

# Which events are logged: a level, or per-module,
# e.g. info,croncave_relay=debug
RUST_LOG=info

# Where this process is running: local | ci | staging | production.
# An unrecognised value stops the service rather than being guessed at.
CRONCAVE_ENV=local

# How log lines are written: pretty | json.
# Left unset it follows the output — pretty in a terminal, JSON when piped or
# collected — which is usually what you want. Set it to force one.
# CRONCAVE_LOG_FORMAT=pretty

# Where errors are reported, from your Sentry or GlitchTip project.
# Blank turns error reporting off, which is the normal local setting.
SENTRY_DSN=

# ---------------------------------------------------------------------------
# Database (crates/db)
# ---------------------------------------------------------------------------

# Postgres, as compose.yaml starts it. Run `docker compose up -d` first.
# The tests create and drop their own databases on this server.
DATABASE_URL=postgres://croncave:croncave@localhost:5432/croncave

# ---------------------------------------------------------------------------
# Control plane (crates/control-plane)
# ---------------------------------------------------------------------------

# Where the API listens. Loopback by default: the browser reaches it through
# the web app, and nothing should bind a public interface by accident.
CRONCAVE_BIND=127.0.0.1:8080

# Size of the Postgres connection pool.
CRONCAVE_DB_MAX_CONNECTIONS=5

# Where workspaces' computers come from: fake (in memory) or local (Docker).
# fly joins them once that account and its terms are settled.
CRONCAVE_COMPUTE_DRIVER=local

# Where the browser reaches the app. Sign-in links point here, so until the
# web app proxies the API (slice 6), swap the host for CRONCAVE_BIND's to
# follow a link by hand.
CRONCAVE_APP_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Web app (web/)
# ---------------------------------------------------------------------------
# A browser can only be given values whose names start with PUBLIC_, so these
# two mirror SENTRY_DSN and CRONCAVE_ENV for code running in the page. The
# private ones above stay authoritative for everything on the server; set
# these only when you want browser errors reported too.
PUBLIC_SENTRY_DSN=
PUBLIC_CRONCAVE_ENV=local

# Where the web app reaches the control plane, server to server. The browser
# never calls this directly.
CRONCAVE_API_URL=http://localhost:8080
